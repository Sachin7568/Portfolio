# Web3Forms access key for the contact form.
# Get it from https://web3forms.com (the key is emailed to you on signup).
# Copy this file to .env.local and paste the key below, then add the same
# variable in your Vercel project settings.
#
# Without this the form falls back to opening the visitor's mail client.
# The key is public by design — it appears in the page markup either way.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL. Used by metadata, JSON-LD, sitemap.xml and robots.txt.
# Defaults to https://sachin.dev when unset.
NEXT_PUBLIC_SITE_URL=
